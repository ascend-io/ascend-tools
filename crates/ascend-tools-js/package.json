{
  "name": "ascend-tools",
  "version": "1.1.0",
  "description": "CLI, SDK, and MCP server for the Ascend Instance web API",
  "main": "./index.js",
  "types": "./index.d.cts",
  "bin": {
    "ascend-tools": "./cli.js"
  },
  "files": [
    "index.js",
    "index.d.cts",
    "cli.js",
    "README.md"
  ],
  "napi": {
    "binaryName": "ascend-tools",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "ava"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3",
    "ava": "^6",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ascend-io/ascend-tools"
  },
  "license": "MIT",
  "homepage": "https://github.com/ascend-io/ascend-tools",
  "keywords": [
    "ascend",
    "ascend-tools",
    "sdk",
    "cli",
    "mcp"
  ]
}
